APP_NAME="EduTech Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Google Gemini 1.5 API Integration (Structured JSON output mode, Temp = 0.2)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.2

# Firebase Firestore & Auth Configuration (kreait/laravel-firebase)
FIREBASE_CREDENTIALS=storage/app/firebase/firebase-credentials.json
FIREBASE_AUTH_TENANT_ID=
FIREBASE_FIRESTORE_DATABASE="(default)"

# Cache & Ephemeral Session Store
CACHE_STORE=file
SESSION_DRIVER=file
