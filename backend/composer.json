{
    "name": "adaptive/learning-platform",
    "type": "project",
    "description": "Zero-Content Adaptive Learning Platform Powered by Generative Artificial Intelligence",
    "keywords": ["adaptive-learning", "gemini-1.5", "zero-content", "ddd", "clean-architecture", "firestore"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "kreait/laravel-firebase": "^5.8",
        "laravel/framework": "^11.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block": false
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
